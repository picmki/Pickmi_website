# ================================================================
# Pickmi - Email Notification Service Configuration
# ================================================================

# Email Provider: 'resend' or 'sendgrid'
EMAIL_PROVIDER=resend

# Resend API Key
RESEND_API_KEY=your_resend_api_key_here

# SendGrid API Key (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Sender Email
FROM_EMAIL=notifications@pickmicabs.com

# Admin Notification Email
ADMIN_NOTIFICATION_EMAIL=admin@pickmicabs.com
