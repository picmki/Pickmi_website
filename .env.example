# ================================================================
# Pickmi - Email Notification Service Configuration
# ================================================================

# Email Provider: 'resend' or 'sendgrid'
EMAIL_PROVIDER=resend

# Resend API Key
RESEND_API_KEY=your_resend_api_key_here

# SendGrid API Key (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Sender Email
FROM_EMAIL=notifications@pickmicabs.com

# Admin Notification Email
ADMIN_NOTIFICATION_EMAIL=admin@pickmicabs.com

# ================================================================
# Pickmi - Twilio SMS / Verify OTP Configuration
# ================================================================

# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token (from Twilio Console)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Option A: Twilio Programmable Phone Number (e.g. +14155552671)
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Custom SMS message template (use {{OTP}} placeholder)
TWILIO_OTP_MESSAGE_TEMPLATE=Welcome to Pickmi! Your OTP is {{OTP}}. Verify your account and get started. Enjoy a smooth drive. Go with us!

# Option B: Twilio Verify Service SID (starts with VA..., recommended for OTP)
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
